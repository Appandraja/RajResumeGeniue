# Copy to the repo root as .env.production (setup.sh does this for you and generates the secrets).
# This file is git-ignored on the server; never commit the real one.

# Public host name of this server. Caddy gets an HTTPS certificate for it.
DOMAIN=srv1989774.hstgr.cloud

POSTGRES_USER=rajresumegenie
POSTGRES_DB=rajresumegenie
POSTGRES_PASSWORD=generated-by-setup-sh
SECRET_KEY=generated-by-setup-sh

# Browser origins allowed to call the API cross-origin. The Android app runs from https://localhost.
CORS_ORIGINS=https://localhost

# Caddy is the only proxy in front of the API.
TRUSTED_PROXY_HOPS=1
DEBUG_CLIENT_IP=false
RATE_LIMIT_ENABLED=true

# Password-reset email: console = write the code to the server log (testing only),
# smtp = real email (fill in the SMTP_* values), disabled = send nothing.
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@your-domain.example
SMTP_USE_TLS=true

# Optional Google sign-in (leave empty to skip)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
