DATABASE_URL=postgresql://user:pass@localhost:5432/rajresumegenie
# Required: at least 32 characters. Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-output-of-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=
RATE_LIMIT_ENABLED=true
# Outgoing email for password reset codes: disabled | console (DEV ONLY, logs the code) | smtp
EMAIL_BACKEND=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@rajresumegenie.local
SMTP_USE_TLS=true
