# Copy to .env.android. Used by `npm run android:sync` (vite --mode android).
#
# Release builds MUST use an HTTPS API URL. A phone cannot reach "localhost" on your PC.
#   Production:        https://api.your-domain.com
#   Emulator (debug):  http://10.0.2.2:8000   (also run: CAP_DEV=true npm run android:sync)
#   Real phone (LAN):  http://<your-pc-lan-ip>:8000   (also run with CAP_DEV=true)
VITE_API_URL=https://api.your-domain.com
