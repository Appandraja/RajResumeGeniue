# Copy to .env and fill in real values. Never commit .env.

# --- PostgreSQL (used by the postgres container; compose builds DATABASE_URL from these) ---
POSTGRES_USER=rajresumegenie
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rajresumegenie

# --- Backend ---
# Local (non-docker) example; docker-compose builds its own URL pointing at host "db"
DATABASE_URL=postgresql://rajresumegenie:change-me@localhost:5432/rajresumegenie
# Required: at least 32 characters. Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-output-of-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Where the browser app is served (used for CORS and the Google OAuth redirect back)
FRONTEND_URL=http://localhost:3000
# Extra comma-separated CORS origins (optional).
# The Android app is served from https://localhost inside its WebView: add it for the app.
CORS_ORIGINS=https://localhost

# In-process request limits on auth and export endpoints (true/false)
RATE_LIMIT_ENABLED=true

# Behind a reverse proxy / load balancer (e.g. Render), set this to the number of proxies that
# append to X-Forwarded-For so rate limits apply per REAL client. 0 = no proxy (local, Docker).
# See DEPLOY.md ("Calibrate the proxy setting"). Never guess a larger number than the truth.
TRUSTED_PROXY_HOPS=0
# Temporary diagnostic to calibrate the value above on a new host. Keep false normally.
DEBUG_CLIENT_IP=false

# Host ports docker compose publishes. Change one if the port is already in use.
# If you change BACKEND_PORT, also change VITE_API_URL below to match (it is baked into the
# web app and the Android app at build time).
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- Email (password reset codes) ---
# disabled = send nothing, console = log the code on the server (DEV ONLY), smtp = real email
EMAIL_BACKEND=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@rajresumegenie.local
SMTP_USE_TLS=true

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the redirect URI registered in Google Cloud Console exactly
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- Frontend (baked in at build time) ---
VITE_API_URL=http://localhost:8000
